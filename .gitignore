# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# cloudflare (opennext)
.open-next/
.wrangler/
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code 本地设置（可能含密钥）
.claude/

# 本地 AI 编辑器技能包（工具配置，不属于站点代码，共 2.6MB）
.agents/
.codex/

# supabase CLI 缓存
supabase/.temp/

# Office 临时锁文件
~$*
