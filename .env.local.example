# 复制本文件为 .env.local 并填入真实值（.env.local 已被 .gitignore 忽略，不会提交）
# 取值位置：Supabase 控制台 → Project Settings → API

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# service_role key —— 服务端专用、权限很大，切勿写进前端组件或提交到仓库
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 审核后台 /admin 的登录密码（自定）
ADMIN_PASSWORD=你的密码

# 部署时填正式域名；本地开发可不填（默认 http://localhost:3000）
# NEXT_PUBLIC_SITE_URL=https://你的域名
